NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NodeMailer configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASS=

# ontask-llm AI microservice
ONTASK_LLM_SERVICE_URL=http://localhost:8000

CRON_SECRET=

# Slack Integration Configuration (Slack App Credentials)
# Create your Slack App at https://api.slack.com/apps and configure:
# Redirect URL: http://localhost:3000/api/integrations/slack/oauth/callback
# Bot Scopes: chat:write, channels:read, groups:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub (Development module) -- a GitHub App, never a personal token.
# Create it at https://github.com/settings/apps/new and configure:
#   Callback URL: http://localhost:3000/api/integrations/github/callback
#   "Request user authorization (OAuth) during installation": ON -- GitHub then
#     returns to the Callback URL after install with the code OnTask uses to
#     confirm the installation belongs to the person connecting it.
#   Webhook URL:  https://<public-host>/api/integrations/github/webhook
#   Repository permissions: Contents (read), Pull requests (read), Metadata (read)
#   Subscribe to events: Create, Push, Pull request
# The private key is the .pem GitHub generates; newlines may be written as \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
